cat > .env << 'EOF'
MYSQL_DATABASE=payment_processing_db
MYSQL_USER=payment_user
MYSQL_PASSWORD=password123
MYSQL_ROOT_PASSWORD=rootpassword

JWT_SECRET=your-256-bit-secret-key-replace-in-production-must-be-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://10.9.67.35:8081

REACT_APP_API_BASE_URL=/api
EOF

cat .env   # sanity check: exactly one CORS_ALLOWED_ORIGINS line, value ends in :8081